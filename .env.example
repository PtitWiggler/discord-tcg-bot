# Token du bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Application ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=

# ID du serveur Discord cible (clic droit sur le serveur > Copier l'ID,
# nécessite le mode développeur activé dans Discord)
DISCORD_GUILD_ID=

# Chemin de la base SQLite, relatif à prisma/schema.prisma.
# Dev : file:./dev.db (déjà utilisé en local, ne pas changer sans mettre à jour .gitignore)
# Prod : utiliser un nom distinct pour ne jamais confondre les deux bases,
# ex. file:./production.db
DATABASE_URL="file:./dev.db"
